# ---- Node server ports ----
PORT_HTTP=3000
PORT_SOCKET=3001

# ---- Speech-to-text (Deepgram) ----
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ---- Text-to-speech provider selection ----
# Currently supported: sixtydb
TTS_PROVIDER=sixtydb

# ---- 60db TTS (https://docs.60db.ai) ----
SIXTYDB_API_KEY=your_60db_api_key_here
SIXTYDB_BASE_URL=https://api.60db.ai
SIXTYDB_WS_URL=wss://api.60db.ai/ws/tts
# Leave SIXTYDB_VOICE_ID blank to use the 60db account default voice.
SIXTYDB_VOICE_ID=
SIXTYDB_OUTPUT_FORMAT=mp3
SIXTYDB_SPEED=1
SIXTYDB_STABILITY=50
SIXTYDB_SIMILARITY=75
SIXTYDB_ENHANCE=true
